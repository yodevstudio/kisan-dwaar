rules_version = '2';

// Deny-by-default (Z4). S2 opens exactly one collection, narrowly, below.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // S2: the upload audit trail. Append-only by construction — update
    // and delete are never allowed, not even to the document's own owner,
    // because an audit trail that can be edited after the fact isn't one.
    match /uploads_audit/{uid}/events/{eventId} {
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }
  }
}
