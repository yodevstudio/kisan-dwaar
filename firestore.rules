rules_version = '2';

// Deny-by-default (Z4). S2 and S3 each open exactly one collection,
// narrowly, below.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // S2: the upload audit trail. Append-only by construction — update
    // and delete are never allowed, not even to the document's own owner,
    // because an audit trail that can be edited after the fact isn't one.
    match /uploads_audit/{uid}/events/{eventId} {
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // S3: anonymous aggregate event counters — docs/ANALYTICS.md. No
    // auth requirement, matching "works for a citizen with no account and
    // no intention of logging in." Read is open because a counter (e.g.
    // "verdict_issued/ELIGIBLE/2026-08-22": 41) carries no PII by
    // construction — that openness is what makes a public dashboard
    // possible at all. Write is constrained to the exact shape docs/
    // ANALYTICS.md §2 defines and to moving count up by exactly 1 per
    // write, so a client can increment a counter and nothing else: not
    // create an arbitrary document, not overwrite another counter's
    // identity fields, not set count to any value it likes.
    match /analytics_counters/{counterId} {
      allow read: if true;
      allow create: if isValidCounterShape(request.resource.data)
                    && request.resource.data.count == 1;
      allow update: if isValidCounterShape(request.resource.data)
                    && request.resource.data.count == resource.data.count + 1
                    && request.resource.data.event_type == resource.data.event_type
                    && request.resource.data.discriminator == resource.data.discriminator
                    && request.resource.data.date == resource.data.date;
      allow delete: if false;
    }
  }
}

function isValidCounterShape(data) {
  return data.event_type in
           ['page_view', 'question_answered', 'verdict_issued', 'scheme_surfaced', 'feedback_vote']
         && data.discriminator is string
         && data.discriminator.size() < 200
         && data.date is string
         && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
         && data.count is int;
}
